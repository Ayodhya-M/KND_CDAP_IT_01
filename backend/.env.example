SUPABASE_URL=https://your-project-ref.supabase.co
# Keep this key on the backend only. Never add it to a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Module 4 uses the deterministic development providers unless explicitly changed.
MODULE2_PROVIDER=mock
MODULE3_PROVIDER=mock
# Required before MODULE2_PROVIDER=real; no formula is approved by default.
# MODULE2_EESI_FORMULA=<approved-formula-id>
MODULE2_REFERENCE_PROFILE=pilot
# Required before MODULE3_PROVIDER=real and must match the trained artifact.
# MODULE3_POSITIVE_CLASS_LABEL=<verified-positive-class-label>
# Optional location of an approved Module 3 saved pipeline.
# MODULE3_ARTIFACT_DIR=artifacts/module3_synthetic
