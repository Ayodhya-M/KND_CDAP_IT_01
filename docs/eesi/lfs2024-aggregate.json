  "formulas": [
    {
      "id": "economic",
      "name": "Economic baseline",
      "expression": "100 \u00d7 (I + C + U) / 3",
      "rationale": "Equal weights provide a transparent economic-only comparator; salary has no effect."
    },
    {
      "id": "additive",
      "name": "Additive salary exposure",
      "expression": "100 \u00d7 (I + C + U + V) / 4",
      "rationale": "Treat income exposure as a separate equally weighted component. This is a hypothesis, not a validated weighting."
    },
    {
      "id": "interaction",
      "name": "Salary interaction",
      "expression": "100 \u00d7 ((I + C + U) / 3) \u00d7 V",
      "rationale": "Test whether salary moderates economic pressure. It becomes zero when normalized economic pressure is zero, a limitation to evaluate."
    }
  ],
